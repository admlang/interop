internal partial module adm.interop.wasm.engine {
	use (
		adm.interop.wasm::*
		std.simd
	)
	// The vector instructions. A v128 is two frame slots, its low and high
	// 64 bits. Most instructions run on a hardware vector (std.simd): the two
	// slots are loaded as one, reread with the instruction's lanes, and the
	// result is stored back. Those std.simd has no exact operation for
	// (the saturating conversions, min and max with WebAssembly's NaN and
	// zero rules, nearest, narrow, extend, shuffle) split their operands
	// into lanes, as unsigned integers in the store's lanesA and lanesB,
	// compute lanesR and pack it.

	// The lanes of `bits` bits of the v128 (low, high), zero-extended.
	def unpack(low int, high int, bits int, out int[]) {
		if bits == 64 {
			out[0] = low
			out[1] = high
			return
		}
		let half = 64 / bits
		let mask = (1 << bits) - 1
		for let i = 0; i < half; i++ {
			out[i] = (low >> (i * bits)) & mask
			out[half + i] = (high >> (i * bits)) & mask
		}
	}

	// Stores lanes of `bits` bits as the v128 at slot `to`.
	def pack(lanes int[], bits int, s int[], to int) {
		if bits == 64 {
			s[to] = lanes[0]
			s[to + 1] = lanes[1]
			return
		}
		let half = 64 / bits
		let mask = (1 << bits) - 1
		let low = 0
		let high = 0
		for let i = 0; i < half; i++ {
			low |= (lanes[i] & mask) << (i * bits)
			high |= (lanes[half + i] & mask) << (i * bits)
		}
		s[to] = low
		s[to + 1] = high
	}

	// A lane of `bits` bits as a signed integer.
	def signedLane(v int, bits int) int {
		return (v << (64 - bits)) >> (64 - bits)
	}

	// v held within the signed integers of `bits` bits.
	def clampSigned(v int, bits int) int {
		let top = (1 << (bits - 1)) - 1
		return top when v > top
		return -top - 1 when v < -top - 1
		return v
	}

	// v held within the unsigned integers of `bits` bits.
	def clampUnsigned(v int, bits int) int {
		return 0 when v < 0
		return (1 << bits) - 1 when v > (1 << bits) - 1
		return v
	}

	// i16x8.q15mulr_sat_s on two lanes: the rounded high half of the product
	// of two Q15 numbers. Only -32768 * -32768 overflows.
	def q15(x int, y int) int {
		let p = (signedLane(x, 16) * signedLane(y, 16) + 0x4000) >> 15
		return p > 32767 ?? (32767, p)
	}

	// Runs the vector instruction `w`; `next` is the index of the word
	// after it. Returns where the following instruction is.
	// Fails with a Trap when a load or a store is out of the memory's bounds.
	def vectorExecute(st Machine, s int[], m byte[], code int[], w int, next int, fp int) !int {
		let pc = next
		let op = (w & 0xffff) - 0x200
		let a = fp + ((w >> 16) & 0xffff)
		let b = fp + ((w >> 32) & 0xffff)
		let c = fp + ((w >> 48) & 0xffff)
		let x = st.lanesA
		let y = st.lanesB
		let r = st.lanesR

		// The instructions a hardware vector computes whole: the two slots
		// are read as one 128-bit vector, reread with the lanes the
		// instruction works on, and the result is stored the same way. An
		// instruction may write the slots it reads: both operands are
		// loaded before the store.
		match op {
			case 0x00:
				// v128.load and v128.store: sixteen bytes of the memory as they are.
				let at = (s[b] & 0xffffffff) + code[pc]
				fail trap("out of bounds memory access") when at + 16 > m.len()
				simd.store2(s, a, simd.load16<byte>(m, at).bitcast2<int>())
				return pc + 1
			case 0x0b:
				let at = (s[a] & 0xffffffff) + code[pc]
				fail trap("out of bounds memory access") when at + 16 > m.len()
				simd.store16(m, at, simd.load2<int>(s, b).bitcast16<byte>())
				return pc + 1
			case 0x0f:
				// The splats: one value in every lane.
				simd.store2(s, a, simd.splat16<int8>(int8(s[b])).bitcast2<int>())
				return pc
			case 0x10:
				simd.store2(s, a, simd.splat8<int16>(int16(s[b])).bitcast2<int>())
				return pc
			case 0x11:
				simd.store2(s, a, simd.splat4<int32>(int32(s[b])).bitcast2<int>())
				return pc
			case 0x13:
				simd.store2(s, a, simd.splat4<int32>(int32(s[b])).bitcast2<int>())
				return pc
			case 0x12, 0x14:
				simd.store2(s, a, simd.splat2<int>(s[b]))
				return pc
			case 0x15:
				// extract_lane: the lane is the third operand. A signed lane and an
				// i32 are sign-extended, an f32 is its bits.
				s[a] = int(simd.load2<int>(s, b).bitcast16<int8>().lane((w >> 48) & 0xffff))
				return pc
			case 0x16:
				s[a] = int(simd.load2<int>(s, b).bitcast16<uint8>().lane((w >> 48) & 0xffff))
				return pc
			case 0x18:
				s[a] = int(simd.load2<int>(s, b).bitcast8<int16>().lane((w >> 48) & 0xffff))
				return pc
			case 0x19:
				s[a] = int(simd.load2<int>(s, b).bitcast8<uint16>().lane((w >> 48) & 0xffff))
				return pc
			case 0x1b:
				s[a] = int(simd.load2<int>(s, b).bitcast4<int32>().lane((w >> 48) & 0xffff))
				return pc
			case 0x1f:
				s[a] = int(simd.load2<int>(s, b).bitcast4<uint32>().lane((w >> 48) & 0xffff))
				return pc
			case 0x1d, 0x21:
				s[a] = simd.load2<int>(s, b).lane((w >> 48) & 0xffff)
				return pc
			case 0x17:
				// replace_lane: the lane follows.
				simd.store2(s, a, simd.load2<int>(s, b).bitcast16<int8>().withLane(code[pc], int8(s[c])).bitcast2<int>())
				return pc + 1
			case 0x1a:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast8<int16>().withLane(code[pc], int16(s[c])).bitcast2<int>())
				return pc + 1
			case 0x1c, 0x20:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast4<int32>().withLane(code[pc], int32(s[c])).bitcast2<int>())
				return pc + 1
			case 0x1e, 0x22:
				simd.store2(s, a, simd.load2<int>(s, b).withLane(code[pc], s[c]))
				return pc + 1
			case 0x23:
				// i8x16: comparisons give all ones or zero in each lane.
				simd.store2(s, a, simd.load2<int>(s, b).bitcast16<int8>().eq(simd.load2<int>(s, c).bitcast16<int8>()).blend(simd.splat16<int8>(int8(-1)), simd.splat16<int8>(int8(0))).bitcast2<int>())
				return pc
			case 0x24:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast16<int8>().ne(simd.load2<int>(s, c).bitcast16<int8>()).blend(simd.splat16<int8>(int8(-1)), simd.splat16<int8>(int8(0))).bitcast2<int>())
				return pc
			case 0x25:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast16<int8>().lt(simd.load2<int>(s, c).bitcast16<int8>()).blend(simd.splat16<int8>(int8(-1)), simd.splat16<int8>(int8(0))).bitcast2<int>())
				return pc
			case 0x26:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast16<uint8>().lt(simd.load2<int>(s, c).bitcast16<uint8>()).blend(simd.splat16<uint8>(uint8(0) - uint8(1)), simd.splat16<uint8>(uint8(0))).bitcast2<int>())
				return pc
			case 0x27:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast16<int8>().gt(simd.load2<int>(s, c).bitcast16<int8>()).blend(simd.splat16<int8>(int8(-1)), simd.splat16<int8>(int8(0))).bitcast2<int>())
				return pc
			case 0x28:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast16<uint8>().gt(simd.load2<int>(s, c).bitcast16<uint8>()).blend(simd.splat16<uint8>(uint8(0) - uint8(1)), simd.splat16<uint8>(uint8(0))).bitcast2<int>())
				return pc
			case 0x29:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast16<int8>().le(simd.load2<int>(s, c).bitcast16<int8>()).blend(simd.splat16<int8>(int8(-1)), simd.splat16<int8>(int8(0))).bitcast2<int>())
				return pc
			case 0x2a:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast16<uint8>().le(simd.load2<int>(s, c).bitcast16<uint8>()).blend(simd.splat16<uint8>(uint8(0) - uint8(1)), simd.splat16<uint8>(uint8(0))).bitcast2<int>())
				return pc
			case 0x2b:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast16<int8>().ge(simd.load2<int>(s, c).bitcast16<int8>()).blend(simd.splat16<int8>(int8(-1)), simd.splat16<int8>(int8(0))).bitcast2<int>())
				return pc
			case 0x2c:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast16<uint8>().ge(simd.load2<int>(s, c).bitcast16<uint8>()).blend(simd.splat16<uint8>(uint8(0) - uint8(1)), simd.splat16<uint8>(uint8(0))).bitcast2<int>())
				return pc
			case 0x60:
				// i8x16: abs, neg, all_true, bitmask, shifts, arithmetic.
				simd.store2(s, a, simd.load2<int>(s, b).bitcast16<int8>().abs().bitcast2<int>())
				return pc
			case 0x61:
				simd.store2(s, a, simd.splat16<int8>(int8(0)).sub(simd.load2<int>(s, b).bitcast16<int8>()).bitcast2<int>())
				return pc
			case 0x62:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast16<uint8>().popcount().bitcast2<int>())
				return pc
			case 0x63:
				s[a] = simd.load2<int>(s, b).bitcast16<int8>().ne(simd.splat16<int8>(int8(0))).all() ?? (1, 0)
				return pc
			case 0x64:
				s[a] = int(simd.load2<int>(s, b).bitcast16<int8>().lt(simd.splat16<int8>(int8(0))).bits())
				return pc
			case 0x6b:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast16<int8>().shl(s[c] & 7).bitcast2<int>())
				return pc
			case 0x6c:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast16<int8>().shr(s[c] & 7).bitcast2<int>())
				return pc
			case 0x6d:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast16<uint8>().shr(s[c] & 7).bitcast2<int>())
				return pc
			case 0x6e:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast16<int8>().add(simd.load2<int>(s, c).bitcast16<int8>()).bitcast2<int>())
				return pc
			case 0x71:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast16<int8>().sub(simd.load2<int>(s, c).bitcast16<int8>()).bitcast2<int>())
				return pc
			case 0x6f:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast16<int8>().addSat(simd.load2<int>(s, c).bitcast16<int8>()).bitcast2<int>())
				return pc
			case 0x70:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast16<uint8>().addSat(simd.load2<int>(s, c).bitcast16<uint8>()).bitcast2<int>())
				return pc
			case 0x72:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast16<int8>().subSat(simd.load2<int>(s, c).bitcast16<int8>()).bitcast2<int>())
				return pc
			case 0x73:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast16<uint8>().subSat(simd.load2<int>(s, c).bitcast16<uint8>()).bitcast2<int>())
				return pc
			case 0x76:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast16<int8>().min(simd.load2<int>(s, c).bitcast16<int8>()).bitcast2<int>())
				return pc
			case 0x77:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast16<uint8>().min(simd.load2<int>(s, c).bitcast16<uint8>()).bitcast2<int>())
				return pc
			case 0x78:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast16<int8>().max(simd.load2<int>(s, c).bitcast16<int8>()).bitcast2<int>())
				return pc
			case 0x79:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast16<uint8>().max(simd.load2<int>(s, c).bitcast16<uint8>()).bitcast2<int>())
				return pc
			case 0x2d:
				// i16x8: comparisons give all ones or zero in each lane.
				simd.store2(s, a, simd.load2<int>(s, b).bitcast8<int16>().eq(simd.load2<int>(s, c).bitcast8<int16>()).blend(simd.splat8<int16>(int16(-1)), simd.splat8<int16>(int16(0))).bitcast2<int>())
				return pc
			case 0x2e:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast8<int16>().ne(simd.load2<int>(s, c).bitcast8<int16>()).blend(simd.splat8<int16>(int16(-1)), simd.splat8<int16>(int16(0))).bitcast2<int>())
				return pc
			case 0x2f:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast8<int16>().lt(simd.load2<int>(s, c).bitcast8<int16>()).blend(simd.splat8<int16>(int16(-1)), simd.splat8<int16>(int16(0))).bitcast2<int>())
				return pc
			case 0x30:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast8<uint16>().lt(simd.load2<int>(s, c).bitcast8<uint16>()).blend(simd.splat8<uint16>(uint16(0) - uint16(1)), simd.splat8<uint16>(uint16(0))).bitcast2<int>())
				return pc
			case 0x31:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast8<int16>().gt(simd.load2<int>(s, c).bitcast8<int16>()).blend(simd.splat8<int16>(int16(-1)), simd.splat8<int16>(int16(0))).bitcast2<int>())
				return pc
			case 0x32:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast8<uint16>().gt(simd.load2<int>(s, c).bitcast8<uint16>()).blend(simd.splat8<uint16>(uint16(0) - uint16(1)), simd.splat8<uint16>(uint16(0))).bitcast2<int>())
				return pc
			case 0x33:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast8<int16>().le(simd.load2<int>(s, c).bitcast8<int16>()).blend(simd.splat8<int16>(int16(-1)), simd.splat8<int16>(int16(0))).bitcast2<int>())
				return pc
			case 0x34:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast8<uint16>().le(simd.load2<int>(s, c).bitcast8<uint16>()).blend(simd.splat8<uint16>(uint16(0) - uint16(1)), simd.splat8<uint16>(uint16(0))).bitcast2<int>())
				return pc
			case 0x35:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast8<int16>().ge(simd.load2<int>(s, c).bitcast8<int16>()).blend(simd.splat8<int16>(int16(-1)), simd.splat8<int16>(int16(0))).bitcast2<int>())
				return pc
			case 0x36:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast8<uint16>().ge(simd.load2<int>(s, c).bitcast8<uint16>()).blend(simd.splat8<uint16>(uint16(0) - uint16(1)), simd.splat8<uint16>(uint16(0))).bitcast2<int>())
				return pc
			case 0x80:
				// i16x8: abs, neg, all_true, bitmask, shifts, arithmetic.
				simd.store2(s, a, simd.load2<int>(s, b).bitcast8<int16>().abs().bitcast2<int>())
				return pc
			case 0x81:
				simd.store2(s, a, simd.splat8<int16>(int16(0)).sub(simd.load2<int>(s, b).bitcast8<int16>()).bitcast2<int>())
				return pc
			case 0x83:
				s[a] = simd.load2<int>(s, b).bitcast8<int16>().ne(simd.splat8<int16>(int16(0))).all() ?? (1, 0)
				return pc
			case 0x84:
				s[a] = int(simd.load2<int>(s, b).bitcast8<int16>().lt(simd.splat8<int16>(int16(0))).bits())
				return pc
			case 0x8b:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast8<int16>().shl(s[c] & 15).bitcast2<int>())
				return pc
			case 0x8c:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast8<int16>().shr(s[c] & 15).bitcast2<int>())
				return pc
			case 0x8d:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast8<uint16>().shr(s[c] & 15).bitcast2<int>())
				return pc
			case 0x8e:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast8<int16>().add(simd.load2<int>(s, c).bitcast8<int16>()).bitcast2<int>())
				return pc
			case 0x91:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast8<int16>().sub(simd.load2<int>(s, c).bitcast8<int16>()).bitcast2<int>())
				return pc
			case 0x8f:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast8<int16>().addSat(simd.load2<int>(s, c).bitcast8<int16>()).bitcast2<int>())
				return pc
			case 0x90:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast8<uint16>().addSat(simd.load2<int>(s, c).bitcast8<uint16>()).bitcast2<int>())
				return pc
			case 0x92:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast8<int16>().subSat(simd.load2<int>(s, c).bitcast8<int16>()).bitcast2<int>())
				return pc
			case 0x93:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast8<uint16>().subSat(simd.load2<int>(s, c).bitcast8<uint16>()).bitcast2<int>())
				return pc
			case 0x95:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast8<int16>().mul(simd.load2<int>(s, c).bitcast8<int16>()).bitcast2<int>())
				return pc
			case 0x96:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast8<int16>().min(simd.load2<int>(s, c).bitcast8<int16>()).bitcast2<int>())
				return pc
			case 0x97:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast8<uint16>().min(simd.load2<int>(s, c).bitcast8<uint16>()).bitcast2<int>())
				return pc
			case 0x98:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast8<int16>().max(simd.load2<int>(s, c).bitcast8<int16>()).bitcast2<int>())
				return pc
			case 0x99:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast8<uint16>().max(simd.load2<int>(s, c).bitcast8<uint16>()).bitcast2<int>())
				return pc
			case 0x37:
				// i32x4: comparisons give all ones or zero in each lane.
				simd.store2(s, a, simd.load2<int>(s, b).bitcast4<int32>().eq(simd.load2<int>(s, c).bitcast4<int32>()).blend(simd.splat4<int32>(int32(-1)), simd.splat4<int32>(int32(0))).bitcast2<int>())
				return pc
			case 0x38:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast4<int32>().ne(simd.load2<int>(s, c).bitcast4<int32>()).blend(simd.splat4<int32>(int32(-1)), simd.splat4<int32>(int32(0))).bitcast2<int>())
				return pc
			case 0x39:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast4<int32>().lt(simd.load2<int>(s, c).bitcast4<int32>()).blend(simd.splat4<int32>(int32(-1)), simd.splat4<int32>(int32(0))).bitcast2<int>())
				return pc
			case 0x3a:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast4<uint32>().lt(simd.load2<int>(s, c).bitcast4<uint32>()).blend(simd.splat4<uint32>(uint32(0) - uint32(1)), simd.splat4<uint32>(uint32(0))).bitcast2<int>())
				return pc
			case 0x3b:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast4<int32>().gt(simd.load2<int>(s, c).bitcast4<int32>()).blend(simd.splat4<int32>(int32(-1)), simd.splat4<int32>(int32(0))).bitcast2<int>())
				return pc
			case 0x3c:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast4<uint32>().gt(simd.load2<int>(s, c).bitcast4<uint32>()).blend(simd.splat4<uint32>(uint32(0) - uint32(1)), simd.splat4<uint32>(uint32(0))).bitcast2<int>())
				return pc
			case 0x3d:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast4<int32>().le(simd.load2<int>(s, c).bitcast4<int32>()).blend(simd.splat4<int32>(int32(-1)), simd.splat4<int32>(int32(0))).bitcast2<int>())
				return pc
			case 0x3e:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast4<uint32>().le(simd.load2<int>(s, c).bitcast4<uint32>()).blend(simd.splat4<uint32>(uint32(0) - uint32(1)), simd.splat4<uint32>(uint32(0))).bitcast2<int>())
				return pc
			case 0x3f:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast4<int32>().ge(simd.load2<int>(s, c).bitcast4<int32>()).blend(simd.splat4<int32>(int32(-1)), simd.splat4<int32>(int32(0))).bitcast2<int>())
				return pc
			case 0x40:
				simd.store2(s, a, simd.load2<int>(s, b).bitcast4<uint32>().ge(simd.load2<int>(s, c).bitcast4<uint32>()).blend(simd.splat4<uint32>(uint32(0) - uint32(1)), simd.splat4<uint32>(uint32(0))).bitcast2<int>())
				return pc
			case 0xa0:
				// i32x4: abs, neg, all_true, bitmask, shifts, arithmetic.
				simd.store2(s, a, simd.load2<int>(s, b).bitcast4<int32>().abs().bitcast2<int>())
