internal partial module adm.interop.wasm.engine {
	use (
		adm.interop.wasm::*
		std.testing
	)

	check "Decoder" {
		@test()
		def decodes_the_spec_modules() {
			let wellFormed = 0
			let rejected = 0
			let invalid = 0
			let invalidRejected string[]
			let wrong string[]
			for let (_, entry) in specCorpus() {
				let name = entry.name
				let failure = ""
				decodeBinary(entry.binary) onerror (err error) {
					failure = err.message
					recover new Binary()
				}
				match entry.kind {
					case 0:
						wellFormed++
						wrong.push("{name}: {failure}") unless failure == ""
					case 1:
						rejected++
						wrong.push("{name}: decoded a malformed module") when failure == ""
					default:
						invalid++
						invalidRejected.push("{name}: {failure}") unless failure == ""
				}
			}
			println(wrong[:wrong.len().min(40)].join("\n")) unless wrong.len() == 0
			assert wrong.len() == 0
			assert wellFormed == 1716 && rejected == 719 && invalid == 2146
			// The two modules that name a data segment without a data count
			// section (testdata/pack.py).
			assert invalidRejected.join("|") == "memory_init:190: wasm: data count section required at byte 34|memory_init:227: wasm: data count section required at byte 41"
		}

		@test()
		def reads_the_sections() !none {
			// (module (type (func (param i32 i64) (result f64))) (import "env" "f" (func (type 0)))
			//   (func (type 0) (local i32 i32) unreachable) (memory 1 2) (export "run" (func 1)))
			let binary = byte[0, 0x61, 0x73, 0x6d, 1, 0, 0, 0, 1, 7, 1, 0x60, 2, 0x7f, 0x7e, 1, 0x7c, 2, 9, 1, 3, 0x65, 0x6e, 0x76, 1, 0x66, 0, 0, 3, 2, 1, 0, 5, 4, 1, 1, 1, 2, 7, 7, 1, 3, 0x72, 0x75, 0x6e, 0, 1, 10, 7, 1, 5, 1, 2, 0x7f, 0, 0x0b]
			let m = try decodeBinary(binary)
			assert m.types.len() == 1 && m.types[0].params.len() == 2 && m.types[0].params[1] == ValueType.I64 && m.types[0].results[0] == ValueType.F64
			assert m.imports.len() == 1 && m.imports[0].moduleName == "env" && m.imports[0].name == "f" && m.imports[0].kind == ExternKind.Function
			assert m.imported(ExternKind.Function) == 1 && m.imported(ExternKind.Memory) == 0
			assert m.functions.len() == 1 && m.bodies.len() == 1 && m.bodies[0].localCount == 2
			assert m.bodies[0].code.to - m.bodies[0].code.from == 2
			assert m.memories.len() == 1 && m.memories[0].min == 1 && m.memories[0].bounded && m.memories[0].max == 2
			assert m.exports.len() == 1 && m.exports[0].name == "run" && m.exports[0].index == 1
			assert !m.hasStart && !m.hasDataCount
			return none
		}

		@test()
		def names_what_is_malformed() {
			let message = ""
			let offset = -1
			decodeBinary(byte[0, 0x61, 0x73, 0x6d, 2, 0, 0, 0]) onerror (err error) {
				message = err.message
				offset = err.offset when err is ModuleError
				recover new Binary()
			}
			assert message == "wasm: unknown binary version at byte 4" && offset == 4
		}
	}
}
