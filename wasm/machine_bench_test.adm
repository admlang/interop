internal partial module adm.interop.wasm.engine {
	use (
		adm.interop.wasm::*
		std.testing
	)

	// A module with a memory of one page and two exports (the text is in
	// the comments of the benchmarks): fib(n i32) i32 and sieve(n i32) i32.
	const benchBinary = byte[0, 0x61, 0x73, 0x6d, 1, 0, 0, 0, 1, 6, 1, 0x60, 1, 0x7f, 1, 0x7f, 3, 3, 2, 0, 0, 5, 3, 1, 0, 1, 7, 0x0f, 2, 3, 0x66, 0x69, 0x62, 0, 0, 5, 0x73, 0x69, 0x65, 0x76, 0x65, 0, 1, 0x0a, 0x7c, 2, 0x1c, 0, 0x20, 0, 0x41, 2, 0x48, 4, 0x7f, 0x20, 0, 5, 0x20, 0, 0x41, 1, 0x6b, 0x10, 0, 0x20, 0, 0x41, 2, 0x6b, 0x10, 0, 0x6a, 0x0b, 0x0b, 0x5d, 1, 3, 0x7f, 0x41, 2, 0x21, 1, 2, 0x40, 3, 0x40, 0x20, 1, 0x20, 0, 0x4f, 0x0d, 1, 0x20, 1, 0x2d, 0, 0, 0x45, 4, 0x40, 0x20, 3, 0x41, 1, 0x6a, 0x21, 3, 0x20, 1, 0x41, 2, 0x6c, 0x21, 2, 2, 0x40, 3, 0x40, 0x20, 2, 0x20, 0, 0x4f, 0x0d, 1, 0x20, 2, 0x41, 1, 0x3a, 0, 0, 0x20, 2, 0x20, 1, 0x6a, 0x21, 2, 0x0c, 0, 0x0b, 0x0b, 0x0b, 0x20, 1, 0x41, 1, 0x6a, 0x21, 1, 0x0c, 0, 0x0b, 0x0b, 0x41, 0, 0x41, 0, 0x20, 0, 0xfc, 0x0b, 0, 0x20, 3, 0x0b]

	let benchLoaded Linked[]

	def benchInstance() !Linked {
		return benchLoaded[0] when benchLoaded.len() > 0
		let store = new Machine()
		let instance = try store.instantiate(try decodeBinary(benchBinary))
		benchLoaded.push(instance)
		return instance
	}

	def benchCall(name string, n int) !int {
		let instance = try benchInstance()
		let results = try instance.invoke(name, Value[Value{kind:ValueType.I32, bits:n}])
		return results[0].bits
	}

	// A module with a memory of one page and vector code (128-bit SIMD):
	// fill(n) writes two arrays of n floats, dot(n) f32 is their dot product,
	// count(n, byte) i32 counts bytes with i8x16.eq and bitmask, mix(n) i32
	// hashes 32-bit lanes with shifts, xor, mul and add.
	const vectorBinary = byte[0, 0x61, 0x73, 0x6d, 1, 0, 0, 0, 1, 0x15, 4, 0x60, 1, 0x7f, 0, 0x60, 1, 0x7f, 1, 0x7d, 0x60, 2, 0x7f, 0x7f, 1, 0x7f, 0x60, 1, 0x7f, 1, 0x7f, 3, 5, 4, 0, 1, 2, 3, 5, 3, 1, 0, 1, 7, 0x1c, 4, 4, 0x66, 0x69, 0x6c, 0x6c, 0, 0, 3, 0x64, 0x6f, 0x74, 0, 1, 5, 0x63, 0x6f, 0x75, 0x6e, 0x74, 0, 2, 3, 0x6d, 0x69, 0x78, 0, 3, 0x0a, 0xad, 2, 4, 0x3b, 1, 1, 0x7f, 2, 0x40, 3, 0x40, 0x20, 1, 0x20, 0, 0x4f, 0x0d, 1, 0x20, 1, 0x41, 2, 0x74, 0x20, 1, 0xb3, 0x43, 0, 0, 0, 0x3f, 0x94, 0x38, 2, 0, 0x20, 1, 0x20, 0, 0x6a, 0x41, 2, 0x74, 0x43, 0, 0, 0, 0x40, 0x38, 2, 0, 0x20, 1, 0x41, 1, 0x6a, 0x21, 1, 0x0c, 0, 0x0b, 0x0b, 0x0b, 0x55, 3, 1, 0x7f, 1, 0x7b, 1, 0x7f, 0x20, 0, 0x41, 2, 0x74, 0x21, 3, 2, 0x40, 3, 0x40, 0x20, 1, 0x20, 3, 0x4f, 0x0d, 1, 0x20, 2, 0x20, 1, 0xfd, 0, 4, 0, 0x20, 1, 0x20, 3, 0x6a, 0xfd, 0, 4, 0, 0xfd, 0xe6, 1, 0xfd, 0xe4, 1, 0x21, 2, 0x20, 1, 0x41, 0x10, 0x6a, 0x21, 1, 0x0c, 0, 0x0b, 0x0b, 0x20, 2, 0xfd, 0x1f, 0, 0x20, 2, 0xfd, 0x1f, 1, 0x92, 0x20, 2, 0xfd, 0x1f, 2, 0x20, 2, 0xfd, 0x1f, 3, 0x92, 0x92, 0x0b, 0x36, 2, 2, 0x7f, 1, 0x7b, 0x20, 1, 0xfd, 0x0f, 0x21, 4, 2, 0x40, 3, 0x40, 0x20, 2, 0x20, 0, 0x4f, 0x0d, 1, 0x20, 3, 0x20, 2, 0xfd, 0, 4, 0, 0x20, 4, 0xfd, 0x23, 0xfd, 0x64, 0x69, 0x6a, 0x21, 3, 0x20, 2, 0x41, 0x10, 0x6a, 0x21, 2, 0x0c, 0, 0x0b, 0x0b, 0x20, 3, 0x0b, 0x62, 2, 1, 0x7f, 1, 0x7b, 0x41, 0xb9, 0xf3, 0xdd, 0xf1, 0x79, 0xfd, 0x11, 0x21, 2, 2, 0x40, 3, 0x40, 0x20, 1, 0x20, 0, 0x4f, 0x0d, 1, 0x20, 2, 0x41, 5, 0xfd, 0xab, 1, 0x20, 2, 0x41, 3, 0xfd, 0xad, 1, 0xfd, 0x51, 0x20, 1, 0xfd, 0, 4, 0, 0x41, 0x93, 0x83, 0x80, 8, 0xfd, 0x11, 0xfd, 0xb5, 1, 0xfd, 0xae, 1, 0x21, 2, 0x20, 1, 0x41, 0x10, 0x6a, 0x21, 1, 0x0c, 0, 0x0b, 0x0b, 0x20, 2, 0xfd, 0x1b, 0, 0x20, 2, 0xfd, 0x1b, 1, 0x73, 0x20, 2, 0xfd, 0x1b, 2, 0x20, 2, 0xfd, 0x1b, 3, 0x73, 0x73, 0x0b]

	let vectorLoaded Linked[]

	def vectorCall(name string, args Value[]) !int {
		if vectorLoaded.len() == 0 {
			let store = new Machine()
			let instance = try store.instantiate(try decodeBinary(vectorBinary))
			try instance.invoke("fill", Value[Value{kind:ValueType.I32, bits:4096}])
			vectorLoaded.push(instance)
		}
		let results = try vectorLoaded[0].invoke(name, args)
		return results[0].bits
	}

	def vectorNumber(n int) Value {
		return Value{kind: ValueType.I32, bits: n}
	}

	check "Machine" {
		@test()
		def runs_the_benchmark_module() !none {
			assert try benchCall("fib", 20) == 6765
			assert try benchCall("sieve", 60000) == 6057
			return none
		}

		@test()
		def stops_when_the_fuel_runs_out() !none {
			let store = new Machine()
			store.metered = true
			store.fuel = 100000
			let instance = try store.instantiate(try decodeBinary(benchBinary))
			let n = Value[Value{kind:ValueType.I32, bits:10}]
			// fib(10) enters the function 177 times.
			try instance.invoke("fib", n)
			assert store.fuel == 100000 - 177
			store.fuel = 50
			let code = ""
			let blank Value[]
			instance.invoke("fib", n) onerror (err error) {
				code = err.code when err is Trap
				recover blank
			}
			assert code == "exhausted"
			// The store works again once it has fuel.
			store.fuel = 1000
			let results = try instance.invoke("fib", n)
			assert results[0].bits == 55
			return none
		}

		// (func $fib (param i32) (result i32) (if (result i32) (i32.lt_s (local.get 0) (i32.const 2))
		//   (then (local.get 0))
		//   (else (i32.add (call $fib (i32.sub (local.get 0) (i32.const 1)))
		//                  (call $fib (i32.sub (local.get 0) (i32.const 2)))))))
		@benchmark()
		def fib_25_recursive_calls() !none {
			assert try benchCall("fib", 25) == 75025
			return none
		}

		// The sieve of Eratosthenes over the first n bytes of the memory:
		// nested loops, byte loads and stores, then one memory.fill.
		@benchmark()
		def sieve_of_60000_bytes() !none {
			assert try benchCall("sieve", 60000) == 6057
			return none
		}

		@test()
		def runs_the_vector_module() !none {
			// 2 * 0.5 * (0 + 1 + ... + 4095), as an f32.
			assert try vectorCall("dot", Value[vectorNumber(4096)]) == bits32(float32(8386560.0))
			assert try vectorCall("count", Value[vectorNumber(32768), vectorNumber(0)]) == 17168
			assert try vectorCall("mix", Value[vectorNumber(32768)]) == int(int32(3953101977))
			return none
		}

		@benchmark()
		def vector_dot_product_of_4096_floats() !none {
			try vectorCall("dot", Value[vectorNumber(4096)])
			return none
		}

		@benchmark()
		def vector_count_in_32768_bytes() !none {
			try vectorCall("count", Value[vectorNumber(32768), vectorNumber(0)])
			return none
		}

		@benchmark()
		def vector_mix_of_32768_bytes() !none {
			try vectorCall("mix", Value[vectorNumber(32768)])
			return none
		}
	}
}
