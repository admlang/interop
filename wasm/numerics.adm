internal partial module adm.interop.wasm.engine {
	use (
		adm.interop.wasm::*
		std.math
	)

	union Bits32 {
		i uint32
		f float32
	}

	union Bits64 {
		i uint64
		f float64
	}

	const minInt = 1 << 63
	const maxInt = 0x7fffffffffffffff

	// Values in frame slots: an i32 is sign-extended, an f32 and an f64
	// are their IEEE 754 bits (the f32 in the low half).
	def f32(bits int) float32 {
		return Bits32.i(uint32(bits)).f
	}

	def bits32(v float32) int {
		return int(Bits32.f(v).i)
	}

	def f64(bits int) float64 {
		return Bits64.i(uint64(bits)).f
	}

	def bits64(v float64) int {
		return int(Bits64.f(v).i)
	}

	// The number of set bits of the 64 in v.
	def ones(v int) int {
		let x = uint64(v)
		x = x - ((x >> 1) & 0x5555555555555555)
		x = (x & 0x3333333333333333) + ((x >> 2) & 0x3333333333333333)
		x = (x + (x >> 4)) & 0x0f0f0f0f0f0f0f0f
		return int((x * 0x0101010101010101) >> 56)
	}

	// The number of zero bits below the lowest set bit of v, which is not 0.
	def trailingZeros(v int) int {
		return ones((v & -v) - 1)
	}

	// The number of zero bits above the highest set bit of v; 64 for 0.
	def leadingZeros(v int) int {
		let x = uint64(v)
		x = x | (x >> 1)
		x = x | (x >> 2)
		x = x | (x >> 4)
		x = x | (x >> 8)
		x = x | (x >> 16)
		x = x | (x >> 32)
		return 64 - ones(int(x))
	}

	// v without its fraction, keeping the sign of a zero result. A NaN
	// comes back quiet.
	def truncate(v float64) float64 {
		return v + v when v != v
		// From 2^52 up every value is whole.
		return v when v >= 4503599627370496.0 || v <= -4503599627370496.0
		let t = float64(int(v))
		return f64(bits64(v) & minInt) when t == 0.0
		return t
	}

	def roundDown(v float64) float64 {
		let t = truncate(v)
		return t - 1.0 when t > v
		return t
	}

	def roundUp(v float64) float64 {
		let t = truncate(v)
		return t + 1.0 when t < v
		return t
	}

	// v rounded to the nearest whole value, a tie going to the even one.
	def nearest(v float64) float64 {
		let t = truncate(v)
		let d = v - t
		return t when d != d || (d < 0.5 && d > -0.5)
		let away = d > 0.0 ?? (t + 1.0, t - 1.0)
		return away when d > 0.5 || d < -0.5
		return t when (int(t) & 1) == 0
		return away
	}

	// The IEEE 754 square root: std.math's gives 0 for a negative value and
	// for -0, where the standard asks for a NaN and for -0.
	def squareRoot(v float64) float64 {
		return v + v when v != v
		return v when v == 0.0
		return (v - v) / (v - v) when v < 0.0
		return float64(math.sqrt(float(v)))
	}

	// The smaller of a and b as WebAssembly defines it: a NaN if either is
	// one, and -0 below +0.
	def smaller(a float64, b float64) float64 {
		return a + b when a != a || b != b
		return f64(bits64(a) | bits64(b)) when a == b
		return a < b ?? (a, b)
	}

	def larger(a float64, b float64) float64 {
		return a + b when a != a || b != b
		return f64(bits64(a) & bits64(b)) when a == b
		return a > b ?? (a, b)
	}

	// The float-to-integer conversions that trap: on a NaN, and on a value
	// whose whole part the integer type cannot hold.
	def truncSigned32(v float64) !int {
		fail trap("invalid conversion to integer") when v != v
		fail trap("integer overflow") unless v > -2147483649.0 && v < 2147483648.0
		return int(v)
	}

	def truncUnsigned32(v float64) !int {
		fail trap("invalid conversion to integer") when v != v
		fail trap("integer overflow") unless v > -1.0 && v < 4294967296.0
		return int(int32(int(v)))
	}

	def truncSigned64(v float64) !int {
		fail trap("invalid conversion to integer") when v != v
		fail trap("integer overflow") unless v >= -9223372036854775808.0 && v < 9223372036854775808.0
		return int(v)
	}

	def truncUnsigned64(v float64) !int {
		fail trap("invalid conversion to integer") when v != v
		fail trap("integer overflow") unless v > -1.0 && v < 18446744073709551616.0
		return int(v) when v < 9223372036854775808.0
		return int(v - 9223372036854775808.0) | minInt
	}

	// The conversions that saturate instead: 0 for a NaN, the nearest
	// bound for a value out of range.
	def saturateSigned32(v float64) int {
		return 0 when v != v
		return -2147483648 when v <= -2147483648.0
		return 2147483647 when v >= 2147483647.0
		return int(v)
	}

	def saturateUnsigned32(v float64) int {
		return 0 when v != v || v <= 0.0
		return -1 when v >= 4294967295.0
		return int(int32(int(v)))
	}

	def saturateSigned64(v float64) int {
		return 0 when v != v
		return minInt when v <= -9223372036854775808.0
		return maxInt when v >= 9223372036854775808.0
		return int(v)
	}

	def saturateUnsigned64(v float64) int {
		return 0 when v != v || v <= 0.0
		return -1 when v >= 18446744073709551616.0
		return int(v) when v < 9223372036854775808.0
		return int(v - 9223372036854775808.0) | minInt
	}

	// Little-endian reads and writes of a memory; the caller checked the
	// bounds.
	def read16(m byte[], at int) int {
		return int(m[at]) | (int(m[at + 1]) << 8)
	}

	def read32(m byte[], at int) int {
		return int(m[at]) | (int(m[at + 1]) << 8) | (int(m[at + 2]) << 16) | (int(m[at + 3]) << 24)
	}

	def read64(m byte[], at int) int {
		return read32(m, at) | (read32(m, at + 4) << 32)
	}

	def write16(m byte[], at int, v int) {
		m[at] = byte(v & 0xff)
		m[at + 1] = byte((v >> 8) & 0xff)
	}

	def write32(m byte[], at int, v int) {
		m[at] = byte(v & 0xff)
		m[at + 1] = byte((v >> 8) & 0xff)
		m[at + 2] = byte((v >> 16) & 0xff)
		m[at + 3] = byte((v >> 24) & 0xff)
	}

	def write64(m byte[], at int, v int) {
		write32(m, at, v)
		write32(m, at + 4, v >> 32)
	}
}
