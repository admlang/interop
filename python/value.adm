partial module adm.interop.python {
	use (
		adm.interop.python.engine::*
	)

	// Value is a Python value held by ADM: a number, a str, a list, a dict,
	// a function, a module. It keeps the value alive in its runtime, and the
	// runtime alive, until it is released or disposed. Methods fail with a
	// ScriptError of kind Closed once the runtime is closed.
	//
	//     let user = try py.eval("\{'name': 'Ada', 'langs': ['adm', 'python']\}")
	//     let name = try (try user.get("name")).asString()
	//     let count = try (try user.get("langs")).len()
	type Value {
		// The runtime the value belongs to.
		runtime Runtime
		// The value's slot in the runtime, its kind in the top byte; 0 once
		// released.
		slot    int

		def new(runtime Runtime, slot int) {
			self.runtime = runtime
			self.slot = slot
		}

		def dispose() {
			return when slot == 0
			ampyRelease(runtime.engine.handle, slot)
			slot = 0
		}

		// What the value is.
		def kind() Kind {
			return Kind(slot >> 56)
		}

		// Whether the value is None.
		def isNone() bool {
			return kind() == Kind.None
		}

		// Whether the script would take the value as true in a condition:
		// not None, False, zero or an empty container.
		def truthy() bool {
			return ampyToBool(runtime.engine.handle, slot)
		}

		// The bool. Fails when the value is not one.
		def asBool() !bool {
			try expect(Kind.Bool, "a bool")
			return ampyToBool(runtime.engine.handle, slot)
		}

		// The number as a float. Fails when the value is not an int or a
		// float.
		def asFloat() !float {
			fail conversion("expected a number, got {describe(kind())}") unless kind() := Kind.Int || Kind.Float
			return ampyToFloat(runtime.engine.handle, slot)
		}

		// The integer: an int, or a float with no fraction. Fails when the
		// value is neither or does not fit 64 bits.
		def asInt() !int {
			let handle = runtime.engine.handle
			if kind() == Kind.Int {
				fail conversion("the int does not fit 64 bits") unless ampyIntFits(handle, slot)
				return ampyToInt(handle, slot)
			}
			try expect(Kind.Float, "an int")
			let n = ampyToFloat(handle, slot)
			fail conversion("{n} is not an integer") when n != n || n != n.floor() || n.abs() >= 9223372036854775808.0
			return int(n)
		}

		// The str. Fails when the value is not a str; text() converts any
		// value.
		def asString() !string {
			try expect(Kind.String, "a str")
			return string(try contents())
		}

		// The bytes of a bytes or a bytearray. Fails when the value is
		// neither.
		def asBytes() !byte[] {
			try expect(Kind.Bytes, "bytes")
			return try contents()
		}

		// The value as the script's str(value) gives it. Fails with a
		// ScriptError when its __str__ raises.
		def text() !string {
			let blob = ampyText(runtime.engine.handle, slot)
			try raise(runtime) when blob == 0
			return string(takeBlob(blob))
		}

		// The value as the script's repr(value) gives it. Fails with a
		// ScriptError when its __repr__ raises.
		def repr() !string {
			let blob = ampyRepr(runtime.engine.handle, slot)
			try raise(runtime) when blob == 0
			return string(takeBlob(blob))
		}

		// The value as text, "" when it has none; what interpolation prints.
		def str() string {
			return slotText(runtime.engine.handle, slot)
		}

		// The ADM object behind a Foreign value; none for any other value.
		def foreign() ?any {
			return none unless kind() == Kind.Foreign
			let id = ampyForeignId(runtime.engine.handle, slot)
			return runtime.engine.keptObject(id)
		}

		// The entry value[name] of a dict, the attribute value.name of
		// anything else. Fails with a ScriptError when there is none.
		def get(name string) !Value {
			return try wrap(runtime, ampyKey(runtime.engine.handle, slot, name)) when kind() == Kind.Dict
			return try wrap(runtime, ampyAttr(runtime.engine.handle, slot, name))
		}

		// value[index]; Python counts from 0, and from the end below it.
		// Fails with a ScriptError when the value has no such item.
		def get(index int) !Value {
			return try wrap(runtime, ampyIndex(runtime.engine.handle, slot, index))
		}

		// value[name] = v for a dict, value.name = v for anything else; v is
		// converted as Runtime.value converts it. Fails with a ScriptError
		// when the assignment raises.
		def set(name string, v any) !none {
			let converted = try runtime.value(v)
			let handle = runtime.engine.handle
			let stored = kind() == Kind.Dict ?? (ampySetKey(handle, slot, name, converted.slot), ampySetAttr(handle, slot, name, converted.slot))
			try raise(runtime) unless stored
			return none
		}

		// value[index] = v.
		// Fails with a ScriptError as set(name, v) does.
		def set(index int, v any) !none {
			let converted = try runtime.value(v)
			try raise(runtime) unless ampySetIndex(runtime.engine.handle, slot, index, converted.slot)
			return none
		}

		// Whether a dict has the key name, or anything else the attribute.
		// Fails with a ScriptError when looking it up raises.
		def has(name string) !bool {
			let handle = runtime.engine.handle
			let found = kind() == Kind.Dict ?? (ampyHasKey(handle, slot, name), ampyHasAttr(handle, slot, name))
			try raise(runtime) when found < 0
			return found == 1
		}

		// del value[name] for a dict, del value.name for anything else.
		// Fails with a ScriptError when there is no such key or attribute.
		def remove(name string) !none {
			let handle = runtime.engine.handle
			let removed = kind() == Kind.Dict ?? (ampyDelKey(handle, slot, name), ampyDelAttr(handle, slot, name))
			try raise(runtime) unless removed
			return none
		}

		// The attribute value.name, of a dict too (its methods).
		// Fails with a ScriptError when there is none.
		def attr(name string) !Value {
			return try wrap(runtime, ampyAttr(runtime.engine.handle, slot, name))
		}

		// value.name = v.
		// Fails with a ScriptError when the assignment raises.
		def setAttr(name string, v any) !none {
			let converted = try runtime.value(v)
			try raise(runtime) unless ampySetAttr(runtime.engine.handle, slot, name, converted.slot)
			return none
		}

		// value[key], key converted as Runtime.value converts it.
		// Fails with a ScriptError when the value has no such item.
		def item(key any) !Value {
			let k = try runtime.value(key)
			return try wrap(runtime, ampyItem(runtime.engine.handle, slot, k.slot))
		}

		// value[key] = v.
		// Fails with a ScriptError when the assignment raises.
		def setItem(key any, v any) !none {
			let k = try runtime.value(key)
			let converted = try runtime.value(v)
			try raise(runtime) unless ampySetItem(runtime.engine.handle, slot, k.slot, converted.slot)
			return none
		}

		// del value[key].
		// Fails with a ScriptError when the value has no such item.
		def removeItem(key any) !none {
			let k = try runtime.value(key)
			try raise(runtime) unless ampyDelItem(runtime.engine.handle, slot, k.slot)
			return none
		}

		// `key in value`.
		// Fails with a ScriptError when the value is not a container.
		def contains(key any) !bool {
			let k = try runtime.value(key)
			let found = ampyContains(runtime.engine.handle, slot, k.slot)
			try raise(runtime) when found < 0
			return found == 1
		}

		// Appends v to a list.
		// Fails with a ScriptError when the value is not a list.
		def append(v any) !none {
			let converted = try runtime.value(v)
			fail conversion("expected a list, got {describe(kind())}") unless kind() == Kind.List
			try raise(runtime) unless ampyAppend(runtime.engine.handle, slot, converted.slot)
			return none
		}

		// A dict's string keys, in the dict's order.
		// Fails with a ScriptError when the value is not a dict.
		def keys() !string[] {
			let blob = ampyKeys(runtime.engine.handle, slot)
			try raise(runtime) when blob == 0
			let raw = takeBlob(blob)
			let out string[]
			let at = 0
			for at + 4 <= raw.len() {
				let n = int(raw[at]) + int(raw[at + 1]) * 256 + int(raw[at + 2]) * 65536 + int(raw[at + 3]) * 16777216
				out.push(string(raw[at + 4:at + 4 + n]))
				at += 4 + n
			}
			return out
		}

		// len(value).
		// Fails with a ScriptError when the value has no length.
		def len() !int {
			let n = ampyLength(runtime.engine.handle, slot)
			try raise(runtime) when n < 0
			return n
		}

		// Calls the value with the arguments, each converted as
		// Runtime.value converts it, and returns the result. Fails with a
		// ScriptError when the value cannot be called or the call raises an
		// exception.
		def call(args ...any) !Value {
			let values = try arguments(args)
			let slots = slotsOf(values)
			return try wrap(runtime, ampyCall(runtime.engine.handle, slot, slots, slots.len(), 0))
		}

		// Calls the value with positional and keyword arguments:
		// value(*args, **named).
		// Fails with a ScriptError as call() does.
		def call(args any[], named map<string, any>) !Value {
			let values = try arguments(args)
			let count = values.len()
			try keywords(values, named)
			let slots = slotsOf(values)
			return try wrap(runtime, ampyCall(runtime.engine.handle, slot, slots, count, (slots.len() - count) / 2))
		}

		// Calls the method value.name(...); arguments and result as in
		// call().
		// Fails with a ScriptError as call() does.
		def invoke(name string, args ...any) !Value {
			let values = try arguments(args)
			let slots = slotsOf(values)
			return try wrap(runtime, ampyInvoke(runtime.engine.handle, slot, name, slots, slots.len(), 0))
		}

		// Calls the method with positional and keyword arguments:
		// value.name(*args, **named).
		// Fails with a ScriptError as call() does.
		def invoke(name string, args any[], named map<string, any>) !Value {
			let values = try arguments(args)
			let count = values.len()
			try keywords(values, named)
			let slots = slotsOf(values)
			return try wrap(runtime, ampyInvoke(runtime.engine.handle, slot, name, slots, count, (slots.len() - count) / 2))
		}

		// Whether both are the same object, as `is` compares.
		def same(other Value) bool {
			return slot == other.slot || ampySame(runtime.engine.handle, slot, other.slot)
		}

		// Whether the script's `value == other` holds; false when comparing
		// raises.
		def equals(other Value) bool {
			return ampyEqual(runtime.engine.handle, slot, other.slot)
		}

		// Converts call arguments.
		internal def arguments(args any[]) !Value[] {
			let out Value[]
			for let (_, a) in args {
				out.push(try runtime.value(a))
			}
			return out
		}

		// Appends each keyword argument to values: its name, then its value.
		internal def keywords(values Value[], named map<string, any>) !none {
			for let (name, v) in named {
				values.push(try runtime.value(name))
				values.push(try runtime.value(v))
			}
			return none
		}

		// The bytes of a str, a bytes or a bytearray.
		internal def contents() !byte[] {
			let blob = ampyBytes(runtime.engine.handle, slot)
			try raise(runtime) when blob == 0
			return takeBlob(blob)
		}

		// Fails unless the value is of this kind.
		internal def expect(want Kind, what string) !none {
			fail conversion("expected {what}, got {describe(kind())}") unless kind() == want
			return none
		}
	}

	// A failed conversion.
	internal def conversion(message string) ScriptError {
		return ScriptError{message: "python: {message}", code: "conversion", kind: ScriptFailure.Conversion}
	}

	// How messages name a kind.
	internal def describe(kind Kind) string {
		match kind {
			case Kind.None:
				return "None"
			case Kind.Bool:
				return "a bool"
			case Kind.Int:
				return "an int"
			case Kind.Float:
				return "a float"
			case Kind.String:
				return "a str"
			case Kind.Bytes:
				return "bytes"
			case Kind.List:
				return "a list"
			case Kind.Tuple:
				return "a tuple"
			case Kind.Dict:
				return "a dict"
			case Kind.Function:
				return "a function"
			case Kind.Module:
				return "a module"
			case Kind.Object:
				return "an object"
			case Kind.Foreign:
				return "an ADM object"
		}
		return "a value"
	}

	// The slots of values, for a call into C.
	internal def slotsOf(values Value[]) int[] {
		let out int[]
		for let (_, v) in values {
			out.push(v.slot)
		}
		return out
	}

	// str(value) for a slot, "" when the conversion raises.
	internal def slotText(handle uint, slot int) string {
		let blob = ampyText(handle, slot)
		if blob == 0 {
			let thrown = ampyException(handle)
			ampyRelease(handle, thrown) unless thrown == 0
			return ""
		}
		return string(takeBlob(blob))
	}
}
