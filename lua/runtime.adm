partial module adm.interop.lua {
	use (
		adm.interop.lua.engine::*
		std.reflection
		std.reflection::(FieldKind)
	)

	// HostFunction is an ADM function a script calls. It gets the call's
	// arguments and returns the result; an error it fails with is raised in
	// the script, and comes back unchanged if the script lets it through.
	type HostFunction = def(Value[]) !Value

	// Engine is the state a Runtime and its values share: the Lua handle and
	// what ADM keeps on the script's behalf.
	internal type Engine {
		// The Lua runtime (adm_lua.c), 0 when it could not be made.
		handle     uint
		weak owner ?Runtime
		// The function C calls for every host function. It holds this engine,
		// so close() drops it.
		host       ?def(int, int, int, int, int, int) int
		functions  HostFunction[]
		// ADM errors travelling through the script, by foreign id.
		errors     map<int, error>
		// ADM objects the script holds, by foreign id.
		objects    map<int, any>
		lastId     int

		def new(memoryLimit int) {
			let me = self
			let entry = def (fn int, argc int, a0 int, a1 int, a2 int, a3 int) int {
				return me.dispatch(fn, argc, a0, a1, a2, a3)
			}
			host = entry
			handle = aluaNew(memoryLimit, entry)
		}

		def dispose() {
			aluaFree(handle) unless handle == 0
		}

		// Runs host function fn for the script; see aluaNew.
		def dispatch(fn int, argc int, a0 int, a1 int, a2 int, a3 int) int {
			let rt = owner
			if rt is none {
				aluaThrow(handle, "the runtime was released", 0)
				return 0
			}
			return hostCall(rt, fn, argc, a0, a1, a2, a3)
		}

		// Adds a host function and returns its id.
		atomic def register(fn HostFunction) int {
			functions.push(fn)
			return functions.len() - 1
		}

		// The host function with this id.
		atomic def function(id int) ?HostFunction {
			return none when id < 0 || id >= functions.len()
			return functions[id]
		}

		// Keeps an error while the script carries it and returns its id.
		atomic def keepError(err error) int {
			lastId++
			errors[lastId] = err
			return lastId
		}

		// The error kept under id.
		atomic def keptError(id int) ?error {
			return errors.get(id)
		}

		// Keeps an object while the script holds it and returns its id.
		atomic def keepObject(obj any) int {
			lastId++
			objects[lastId] = obj
			return lastId
		}

		// The object kept under id.
		atomic def keptObject(id int) ?any {
			return objects.get(id)
		}

		// Forgets what the script no longer holds.
		atomic def forget(ids int[], n int) {
			for let i = 0; i < n; i++ {
				errors.delete(ids[i])
				objects.delete(ids[i])
			}
		}

		// Drops everything held for the script.
		atomic def clear() {
			host = none
			functions = []
			errors = errors.pickKeys(int[])
			objects = objects.pickKeys(int[])
		}
	}

	// Runtime is one Lua 5.4 state: its own heap, globals and modules.
	// Scripts get the base, coroutine, table, string, math and utf8
	// libraries; no files, clock, process or dynamic libraries beyond what
	// the program gives them as host functions.
	//
	//     let lua = new Runtime()
	//     let sum = try lua.eval("return 1 + 2")
	//     println(try sum.asInt())
	//
	// Any task may use a runtime; calls run one at a time. A value belongs to
	// the runtime that made it and keeps it alive.
	type Runtime {
		// Shared with this runtime's values.
		engine Engine

		// memoryLimit is bytes, 0 for none; a script that needs more fails
		// with a ScriptError of kind OutOfMemory. timeout bounds every call
		// into the script, 0s for none.
		def new(memoryLimit int = 0, timeout duration = 0s) {
			engine = new Engine(memoryLimit)
			engine.owner = self
			aluaTimeout(engine.handle, int(timeout)) when engine.handle != 0 && timeout > 0s
		}

		def dispose() {
			aluaClose(engine.handle) when engine.handle != 0
			engine.clear()
		}

		// Frees the state and everything the script holds. Values made by
		// this runtime fail from here on. Fails when called from a host
		// function, which runs inside the script it would free.
		def close() !none {
			return none when engine.handle == 0
			fail ScriptError{message: "lua: close called from a host function", code: "closed", kind: ScriptFailure.Closed} unless aluaClose(engine.handle)
			engine.clear()
			return none
		}

		// Runs a chunk and returns its first result, nil when it returns
		// nothing. name is what error messages call the chunk. Fails with a
		// ScriptError when it does not compile or raises an error.
		def eval(code string, name string = "eval") !Value {
			return try wrap(self, aluaEval(engine.handle, code, name))
		}

		// Makes a module's source available to `require` under name, without
		// running it. A module runs once, when first required or loaded.
		def define(name string, source string) {
			aluaDefine(engine.handle, name, source) unless engine.handle == 0
		}

		// Runs the module defined under name and returns its value: what
		// the chunk returns, usually a table, or true when it returns
		// nothing. A second load returns the same value. Fails with a
		// ScriptError when the module is not defined, does not compile or
		// raises an error.
		def load(name string) !Value {
			return try wrap(self, aluaRequire(engine.handle, name))
		}

		// Defines the module and runs it.
		// Fails with a ScriptError as load(name) does.
		def load(name string, source string) !Value {
			define(name, source)
			return try load(name)
		}

		// A field of a module's table, loading the module when needed.
		// Fails with a ScriptError as load(name) does.
		def get(moduleName string, name string) !Value {
			let unit = try load(moduleName)
			return try unit.get(name)
		}

		// Compiles a chunk to Lua bytecode for run(). strip leaves out line
		// numbers and names. Fails with a ScriptError when the source does
		// not compile.
		def compile(source string, name string = "eval", strip bool = false) !byte[] {
			let blob = aluaCompile(engine.handle, source, name, strip)
			try raise(self) when blob == 0
			return takeBlob(blob)
		}

		// Runs bytecode from compile() and returns its first result. The
		// bytes must come from compile() of this library version: Lua does
		// not verify bytecode, so anything else can crash the program.
		// Fails with a ScriptError when the code raises an error.
		def run(bytecode byte[]) !Value {
			return try wrap(self, aluaRun(engine.handle, bytecode, bytecode.len()))
		}

		// The table of globals.
		// Fails with a ScriptError when the runtime is closed.
		def global() !Value {
			return try wrap(self, aluaGlobals(engine.handle))
		}

		// Lua's nil.
		// Fails with a ScriptError when the runtime is closed.
		def nil() !Value {
			return try wrap(self, aluaNil(engine.handle))
		}

		// A boolean.
		// Fails with a ScriptError when the runtime is closed.
		def value(v bool) !Value {
			return try wrap(self, aluaBool(engine.handle, v))
		}

		// An integer.
		// Fails with a ScriptError when the runtime is closed.
		def value(v int) !Value {
			return try wrap(self, aluaInteger(engine.handle, v))
		}

		// A float.
		// Fails with a ScriptError when the runtime is closed.
		def value(v float) !Value {
			return try wrap(self, aluaNumber(engine.handle, v))
		}

		// A string.
		// Fails with a ScriptError when the runtime is closed.
		def value(v string) !Value {
			return try wrap(self, aluaString(engine.handle, v))
		}

		// A Lua string holding these bytes: Lua strings are byte strings.
		// Fails with a ScriptError when the runtime is closed.
		def bytes(v byte[]) !Value {
			return try wrap(self, aluaStringOf(engine.handle, v, v.len()))
		}

		// Converts an ADM value: a Value stays itself, none is nil, numbers,
		// bools and strings convert, byte[] becomes a string of those bytes,
		// other arrays become tables indexed from 1 and string-keyed maps
		// tables (copied, element by element). Anything else, a struct or a
		// type object, crosses as a Foreign value the script can hold and
		// pass back but not look into; copy() makes a table of its fields
		// instead.
		// Fails with a ScriptError when the runtime is closed.
		def value(v any) !Value {
			return try nil() when v is none
			return v when v is Value
			return try bytes(byte[](v)) when reflection.typeName(v) == "byte[]"
			return try value(v) when v is string
			return try value(v) when v is int
			return try value(v) when v is float
			return try value(v) when v is bool
			match reflection.kindOf(v) {
				case FieldKind.Bool:
					return try value(reflection.scalarText(v) == "true")
				case FieldKind.Int, FieldKind.Uint, FieldKind.Enum:
					return try value(reflection.scalarText(v).toInt<int>())
				case FieldKind.Float:
					return try value(parseFloat<float>(reflection.scalarText(v)))
				case FieldKind.String:
					return try value(reflection.scalarText(v))
				case FieldKind.Array:
					let out = try table()
					for let (i, e) in reflection.elements(v) {
						try out.set(i + 1, e)
					}
					return out
				case FieldKind.Map:
					let out = try table()
					for let key in reflection.keysOf(v) {
						let e = reflection.entryOf(v, key)
						try out.set(key, e) unless e is none
					}
					return out
				default:
					return try foreign(v) unless reflection.typeName(v) == "none"
			}
			return try nil()
		}

		// A table holding a copy of v's fields, by name, each converted as
		// value() converts it except that nested structs are copied too.
		// Arrays and maps are copied the same way; anything else converts as
		// value() does.
		// Fails with a ScriptError when the runtime is closed.
		def copy(v any) !Value {
			let kind = reflection.kindOf(v)
			if kind == FieldKind.Array {
				return try bytes(byte[](v)) when reflection.typeName(v) == "byte[]"
				let out = try table()
				for let (i, e) in reflection.elements(v) {
					try out.set(i + 1, try copy(e))
				}
				return out
			}
			if kind == FieldKind.Map {
				let out = try table()
				for let key in reflection.keysOf(v) {
					let e = reflection.entryOf(v, key)
					try out.set(key, try copy(e)) unless e is none
				}
				return out
			}
			if kind == FieldKind.Struct {
				let out = try table()
				for let (_, f) in reflection.fields(v) {
					try out.set(f.name, try copyField(f))
				}
				return out
			}
			return try value(v)
		}

		// One field of a struct, as copy() copies it.
		internal def copyField(f reflection.Field) !Value {
			let kind = f.kind
			if kind == FieldKind.Array {
				if f.typeName == "byte[]" {
					let raw byte[]
					for let i = 0; i < f.len(); i++ {
						raw.push(byte(f.at(i).asUint()))
					}
					return try bytes(raw)
				}
				let out = try table()
				for let i = 0; i < f.len(); i++ {
					try out.set(i + 1, try copyPart(f.at(i), f.elemKind))
				}
				return out
			}
			if kind == FieldKind.Map {
				let out = try table()
				for let key in f.keys() {
					try out.set(key, try copyPart(f.entry(key), f.elemKind))
				}
				return out
			}
			return try copyPart(f, kind)
		}

		// A scalar or nested object addressed by f: a field, an array element
		// or a map entry holding this kind.
		internal def copyPart(f reflection.Field, kind FieldKind) !Value {
			match kind {
				case FieldKind.Bool:
					return try value(f.asBool())
				case FieldKind.Int, FieldKind.Enum:
					return try value(f.asInt())
				case FieldKind.Uint:
					return try value(int(f.asUint()))
				case FieldKind.Float:
					return try value(f.asFloat())
				case FieldKind.String:
					return try value(f.asString())
				default:
					let inner = f.value()
					return try nil() when inner is none
					return try copy(inner)
			}
			return try nil()
		}

		// An empty table.
		// Fails with a ScriptError when the runtime is closed.
		def table() !Value {
			return try wrap(self, aluaTable(engine.handle))
		}

		// A function the script can call, running fn.
		//
		//     let add = try lua.function((args) => lua.value(try args[0].asInt() + try args[1].asInt()))
		//     try (try lua.global()).set("add", add)
		// Fails with a ScriptError when the runtime is closed.
		def function(fn HostFunction) !Value {
			let id = engine.register(fn)
			return try wrap(self, aluaFunction(engine.handle, id))
		}

		// An opaque object standing for obj. The script can hold it and pass
		// it back (Value.foreign() returns obj) but not look into it. obj
		// stays alive while the script holds the object.
		// Fails with a ScriptError when the runtime is closed.
		def foreign(obj any) !Value {
			reap(self)
			let id = engine.keepObject(obj)
			return try wrap(self, aluaForeign(engine.handle, id))
		}

		// Stops the script that is running, or the next call if none is: it
		// fails with a ScriptError of kind Interrupted. Callable from any
		// task. A script is stopped between its own instructions, not inside
		// a library function such as string.rep.
		def interrupt() {
			aluaInterrupt(engine.handle) unless engine.handle == 0
		}

		// Sets how long a call into the script may run, 0s for no limit. A
		// call that runs longer fails with a ScriptError of kind TimedOut.
		def timeout(limit duration) {
			aluaTimeout(engine.handle, int(limit)) unless engine.handle == 0
		}

		// Bytes the state's heap holds.
		def memory() int {
			return engine.handle == 0 ?? (0, aluaMemory(engine.handle))
		}

		// Values of this runtime that ADM holds.
		def live() int {
			return engine.handle == 0 ?? (0, aluaLive(engine.handle))
		}

		// Runs a full garbage collection now.
		def collect() {
			aluaCollect(engine.handle) unless engine.handle == 0
			reap(self)
		}
	}

	// Wraps a slot from C; fails with what the script raised when it is 0.
	internal def wrap(rt Runtime, slot int) !Value {
		try raise(rt) when slot == 0
		return new Value(rt, slot)
	}

	// Fails with the error the last call put aside: the ADM error a host
	// function failed with when that is what the script let through, else a
	// ScriptError.
	internal def raise(rt Runtime) !none {
		let handle = rt.engine.handle
		fail ScriptError{message: "lua: the runtime could not be created", code: "closed", kind: ScriptFailure.Closed} when handle == 0
		let stop = aluaStopReason(handle)
		let slot = aluaException(handle)
		fail ScriptError{message: "lua: the script was interrupted", code: "interrupted", kind: ScriptFailure.Interrupted} when stop == 1
		fail ScriptError{message: "lua: the script ran longer than its timeout", code: "timeout", kind: ScriptFailure.TimedOut} when stop == 2
		fail ScriptError{message: "lua: the script ran out of memory", code: "memory", kind: ScriptFailure.OutOfMemory} when stop == 3
		fail ScriptError{message: "lua: the runtime is closed", code: "closed", kind: ScriptFailure.Closed} when slot == 0
		let thrown = new Value(rt, slot)
		if thrown.kind() == Kind.Table {
			let carried = aluaGet(handle, slot, "admError")
			if carried != 0 {
				let id = aluaForeignId(handle, carried)
				aluaRelease(handle, carried)
				if id != 0 {
					let original = rt.engine.keptError(id)
					fail original unless (original is none)
				}
			}
		}
		let trace = aluaTrace(handle)
		fail ScriptError{message: "lua: {thrown.str()}", code: "thrown", kind: ScriptFailure.Thrown, trace: string(takeBlob(trace)), value: thrown}
	}

	// Runs host function fn for the script; see aluaNew.
	internal def hostCall(rt Runtime, fn int, argc int, a0 int, a1 int, a2 int, a3 int) int {
		let args Value[]
		args.push(new Value(rt, a0)) when argc > 0
		args.push(new Value(rt, a1)) when argc > 1
		args.push(new Value(rt, a2)) when argc > 2
		args.push(new Value(rt, a3)) when argc > 3
		if argc > 4 {
			let rest int[]
			rest.len(argc - 4)
			let n = aluaArgs(rt.engine.handle, rest, argc - 4)
			for let i = 0; i < n; i++ {
				args.push(new Value(rt, rest[i]))
			}
		}
		let target = rt.engine.function(fn)
		if target is none {
			aluaThrow(rt.engine.handle, "the host function is gone", 0)
			return 0
		}
		let failure ?error = none
		let out = callHost(target, args) onerror (err error) {
			failure = err
			recover none
		}
		if !(failure is none) {
			throwError(rt, failure)
			return 0
		}
		return -1 when out is none
		return out.slot
	}

	// Raises err in the script: the value it carries when it is what a
	// script raised here, else an error that keeps err to fail with later.
	internal def throwError(rt Runtime, err error) {
		if err is ScriptError {
			let thrown = err.value
			if !(thrown is none) {
				if thrown.runtime.engine.handle == rt.engine.handle {
					aluaThrowValue(rt.engine.handle, thrown.slot)
					return
				}
			}
		}
		reap(rt)
		let id = rt.engine.keepError(err)
		aluaThrow(rt.engine.handle, err.message, id)
	}

	// Forgets the errors and objects whose script-side object was
	// collected.
	internal def reap(rt Runtime) {
		return when rt.engine.handle == 0
		let ids int[]
		ids.len(64)
		for {
			let n = aluaDead(rt.engine.handle, ids, 64)
			rt.engine.forget(ids, n)
			break when n < 64
		}
	}

	// Calls a host function; none stands for a result that is nil.
	internal def callHost(fn HostFunction, args Value[]) !?Value {
		let out = try fn(args)
		return none when out.kind() == Kind.Nil
		return out
	}

	// Copies a blob from C into ADM and frees it.
	internal def takeBlob(blob uint) byte[] {
		let n = aluaBlobLen(blob)
		let out byte[]
		out.len(n)
		aluaBlobTake(blob, out, n)
		return out
	}
}
