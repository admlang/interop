// The C side of adm.interop.dotnet (host/adm_dotnet.c): the .NET runtime on
// a thread of its own, and the bridge assembly behind adnRequest. A blob is
// a block of bytes the C side made and the caller reads and frees.
@link("dl")
internal module adm.interop.dotnet.host {
	// Finds libhostfxr under root, else beside the `dotnet` on path, else in
	// the usual places; writes its path to `out` and returns its length, 0
	// for none.
	def adnLocate(root string, path string, out byte[], capacity int) int;

	// Starts the process's .NET runtime: fxr is libhostfxr, config the
	// runtime configuration file, bridge the bridge assembly. Returns 0, or
	// the length of the reason written to `why`.
	def adnStart(fxr string, config string, bridge string, why byte[], capacity int) int;

	// Hands a request, `head` followed by `data`, to the bridge and waits.
	// Returns 0 with the answer as a blob in out[0], or 1 when .NET calls a
	// function of the program: its arguments are a blob in out[0], out[1]
	// is the call, out[2] the function and out[3] the request, for
	// adnResume.
	def adnRequest(head byte[], headSize int, data byte[], size int, out int[]) int;

	// Answers the call adnRequest returned and waits again, as it does.
	def adnResume(request uint, call uint, reply byte[], size int, out int[]) int;

	def adnBlobSize(blob uint) int;

	def adnBlobRead(blob uint, out byte[], size int);

	def adnBlobFree(blob uint);

	// Copies `bytes` bytes of an array or a string into a request, at `at`.
	@c(symbol = "adnPut")
	def adnPutText(dst byte[], at int, src string, bytes int);

	@c(symbol = "adnPut")
	def adnPutBytes(dst byte[], at int, src byte[], bytes int);

	@c(symbol = "adnPut")
	def adnPutInt8(dst byte[], at int, src int8[], bytes int);

	@c(symbol = "adnPut")
	def adnPutInt16(dst byte[], at int, src int16[], bytes int);

	@c(symbol = "adnPut")
	def adnPutInt32(dst byte[], at int, src int32[], bytes int);

	@c(symbol = "adnPut")
	def adnPutInt64(dst byte[], at int, src int[], bytes int);

	@c(symbol = "adnPut")
	def adnPutInt64s(dst byte[], at int, src int64[], bytes int);

	@c(symbol = "adnPut")
	def adnPutFloat32(dst byte[], at int, src float32[], bytes int);

	@c(symbol = "adnPut")
	def adnPutFloat(dst byte[], at int, src float[], bytes int);

	@c(symbol = "adnPut")
	def adnPutFloat64(dst byte[], at int, src float64[], bytes int);

	@c(symbol = "adnPut")
	def adnPutUint16(dst byte[], at int, src uint16[], bytes int);

	@c(symbol = "adnPut")
	def adnPutUint32(dst byte[], at int, src uint32[], bytes int);

	@c(symbol = "adnPut")
	def adnPutUint64(dst byte[], at int, src uint[], bytes int);

	// Copies `bytes` bytes of an answer, from `at`, into an array.
	@c(symbol = "adnTake")
	def adnTakeInt8(dst int8[], src byte[], at int, bytes int);

	@c(symbol = "adnTake")
	def adnTakeInt16(dst int16[], src byte[], at int, bytes int);

	@c(symbol = "adnTake")
	def adnTakeInt32(dst int32[], src byte[], at int, bytes int);

	@c(symbol = "adnTake")
	def adnTakeInt64(dst int[], src byte[], at int, bytes int);

	@c(symbol = "adnTake")
	def adnTakeInt64s(dst int64[], src byte[], at int, bytes int);

	@c(symbol = "adnTake")
	def adnTakeFloat32(dst float32[], src byte[], at int, bytes int);

	@c(symbol = "adnTake")
	def adnTakeFloat(dst float[], src byte[], at int, bytes int);

	@c(symbol = "adnTake")
	def adnTakeFloat64(dst float64[], src byte[], at int, bytes int);

	@c(symbol = "adnTake")
	def adnTakeUint16(dst uint16[], src byte[], at int, bytes int);

	@c(symbol = "adnTake")
	def adnTakeUint32(dst uint32[], src byte[], at int, bytes int);

	@c(symbol = "adnTake")
	def adnTakeUint64(dst uint[], src byte[], at int, bytes int);

	// The length of a string in bytes.
	def adnTextSize(text string) int;
}
