partial module adm.interop.js {
	use std.testing

	internal struct Line {
		name     string
		price    float
		quantity int
		tags     string[]
	}

	@js("testdata/billing.js")
	internal def total(items Line[]) !float;

	@js("testdata/billing.js")
	internal def count() int;

	@js("testdata/billing.js")
	internal def greet(name string, excited bool) string;

	@js("testdata/billing.js")
	internal def maybe(n int) ?int;

	@js("testdata/billing.js")
	internal def checksum(bytes byte[]) int;

	@js("testdata/billing.js")
	internal def scale(samples float32[], factor float) string;

	@js("testdata/billing.js")
	internal def squares(n int) int[];

	@js("testdata/billing.js")
	internal def halves(n int) float32[];

	@js("testdata/billing.js")
	internal def words(text string) string[];

	@js("testdata/billing.js")
	internal def flags() bool[];

	@js("testdata/billing.js")
	internal def reversed(bytes byte[]) byte[];

	@js("testdata/billing.js")
	internal def big() int;

	@js("testdata/billing.js")
	internal def tooBig() !uint8;

	@js("testdata/billing.js")
	internal def later(n int) !int;

	@js("testdata/billing.js")
	internal def refuse(reason string) !none;

	@js("testdata/billing.js")
	internal def nothing();

	@js("testdata/billing.js")
	internal def summary(item Line) !Value;

	@js("testdata/billing.js")
	internal def orElse(value ?string, fallback string) string;

	internal struct Receipt {
		label  string
		lines  int
		paid   bool
		total  float
		tags   string[]
		first  Line
		all    Line[]
		byName map<string, float>
		note   ?string
	}

	@js("testdata/billing.js")
	internal def receipt(items Line[], note ?string) !Receipt;

	@js("testdata/billing.js")
	internal def receipts(items Line[]) Receipt[];

	@js("testdata/billing.js")
	internal def priceList(items Line[]) map<string, float>;

	@js("testdata/billing.js")
	internal def index(items Line[]) !map<string, Line>;

	@js("testdata/billing.js")
	internal def wrongShape() !Receipt;

	@js("testdata/billing.js")
	internal def notAFunction() !int;

	@js("testdata/billing.js")
	internal def missing() !int;

	// The error a failing declaration failed with, as a ScriptError.
	internal def scriptFailure(err ?error) !ScriptError {
		fail "the declaration did not fail" when err is none
		fail "not a ScriptError: {err.message}" unless err is ScriptError
		return err
	}

	check "Declarations" {
		@test()
		def calls_the_export_of_the_same_name() !none {
			let cart = [Line{name:"pen", price:1.5, quantity:4, tags:[]}, Line{name:"ink", price:7.0, quantity:1, tags:[]}]
			assert try total(cart) == 13.0
			assert greet("Ada", true) == "hello Ada!"
			assert greet("Bob", false) == "hello Bob"
			assert orElse("set", "unset") == "set"
			assert orElse(none, "unset") == "unset"
			nothing()
			return none
		}

		@test()
		def runs_the_module_once() {
			let first = count()
			assert count() == first + 1
			assert count() == first + 2
			assert runtime().live() > 0
		}

		@test()
		def converts_results() !none {
			let some = maybe(3)
			assert some is int && some == 3
			let gone = maybe(0)
			assert gone is none
			assert squares(4).str() == int[0, 1, 4, 9].str()
			let h = halves(3)
			assert h.len() == 3 && h[1] == 0.5 && h[2] == 1.0
			assert words("a bc d").join("|") == "a|bc|d"
			let f = flags()
			assert f.len() == 3 && f[0] && !f[1] && f[2]
			assert reversed(byte[1, 2, 3]).hex() == "030201"
			assert big() == 4611686018427387904
			assert try later(21) == 42
			let made = try summary(Line{name: "pen", price: 1.5, quantity: 4, tags: ["a", "b"]})
			assert try (try made.get("label")).asString() == "pen x4"
			assert try (try made.get("tags")).json() == "[\"a\",\"b\"]"
			return none
		}

		@test()
		def builds_structs_and_maps() !none {
			let cart = [Line{name:"pen", price:1.5, quantity:4, tags:["blue"]}, Line{name:"ink", price:7.0, quantity:1, tags:[]}]
			let r = try receipt(cart, "thanks")
			assert r.label == "2 lines" && r.lines == 2 && r.paid && r.total == 13.0
			assert r.tags.join(",") == "pen,ink"
			assert r.first.name == "pen" && r.first.quantity == 4 && r.first.tags.join(",") == "blue"
			assert r.all.len() == 2 && r.all[1].name == "ink" && r.all[1].price == 7.0
			assert r.byName["ink"] == 7.0
			let note = r.note
			assert note is string && note == "thanks"
			assert (try receipt(cart, none)).note is none

			let each = receipts(cart)
			assert each.len() == 2 && each[0].label == "1 lines" && each[1].first.name == "ink"
			let prices = priceList(cart)
			assert prices.len() == 2 && prices["pen"] == 1.5
			let byName = try index(cart)
			assert byName.len() == 2 && byName["ink"].price == 7.0 && byName["pen"].quantity == 4 && byName["pen"].tags.join(",") == "blue"

			let failure ?error = none
			let _ = wrongShape() onerror (err error) {
				failure = err
				recover Receipt{}
			}
			assert (try scriptFailure(failure)).kind == ScriptFailure.Conversion
			return none
		}

		@test()
		def lends_arrays() {
			let data = byte[1, 2, 3]
			assert checksum(data) == 6
			assert data[0] == 6
			let samples float32[] = [0.5, 1.5]
			assert scale(samples, 2.0) == "Float32Array"
			assert samples[0] == 1.0 && samples[1] == 3.0
		}

		@test()
		def fails_as_script_errors() !none {
			let failure ?error = none
			refuse("too much") onerror (err error) {
				failure = err
				recover none
			}
			let thrown = try scriptFailure(failure)
			assert thrown.kind == ScriptFailure.Thrown
			assert thrown.name == "RangeError"
			assert thrown.message == "js: RangeError: too much"

			failure = none
			let _ = tooBig() onerror (err error) {
				failure = err
				recover uint8(0)
			}
			assert (try scriptFailure(failure)).kind == ScriptFailure.Conversion

			failure = none
			let _ = notAFunction() onerror (err error) {
				failure = err
				recover 0
			}
			assert (try scriptFailure(failure)).message == "js: testdata/billing.js exports no function notAFunction"

			failure = none
			let _ = missing() onerror (err error) {
				failure = err
				recover 0
			}
			assert (try scriptFailure(failure)).message == "js: testdata/billing.js exports no function missing"
			return none
		}
	}
}
