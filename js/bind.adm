partial module adm.interop.js {
	use (
		adm.interop.js.quickjs::*
		std.reflection
		std.reflection::(EmbeddedFile, FieldKind, FunctionMetaContext)
	)

	// Holds the runtime of the program's `@js` declarations.
	internal type Shared {
		made ?Runtime

		atomic def get() Runtime {
			let known = made
			if known is none {
				let fresh = new Runtime()
				made = fresh
				return fresh
			}
			return known
		}

		def dispose() {
			let known = made
			dispose known unless known is none
		}
	}

	internal let shared = new Shared()

	// The runtime the program's `@js` declarations run in, made on first use
	// and kept for the whole run. Give scripts their host functions through
	// its global object before the first declaration is called.
	def runtime() Runtime {
		return shared.get()
	}

	// Binds a function declared without a body to the export of the same name
	// in an ES module file, which is embedded at build time:
	//
	//     @js("billing.js")
	//     def total(items Item[]) !float;
	//
	// The file is named relative to the source file of the declaration and
	// runs once, in runtime(), when one of its functions is first called.
	// Arguments cross as Value.call passes them, except that structs are
	// copied into plain objects, field by field, and numeric arrays that
	// have a typed array (Runtime.lend) are lent for the call. The result is
	// converted to the declared type: bool, a number, string, byte[], an
	// array of those, a struct (filled from an object, property by field
	// name), an array of structs, a `map<string, V>`, `Value` for the
	// script's value as it is, or nothing; `?T` takes null and undefined as
	// none. A promise is waited for.
	//
	// A script that throws, a missing export and a result that does not
	// convert fail an errorable declaration with a ScriptError, and panic
	// with its message when the declaration cannot fail.
	meta def js(target FunctionMetaContext, file EmbeddedFile) {
		let failure ?error = none
		answer(target, file) onerror (err error) {
			failure = err
			recover none
		}
		target.reject(failure) unless failure is none
	}

	// Calls the script function behind a declaration and resolves the call.
	internal def answer(target FunctionMetaContext, file EmbeddedFile) !none {
		let fn = try exported(target, file)
		let out = try callWith(fn, target.args())
		let settled = try out.wait()
		return try settle(target, settled, target.descriptor.signature.result.node.qualifiedName)
	}

	// The script function a declaration names, looked up once and kept in
	// the declaration's slot.
	internal def exported(target FunctionMetaContext, file EmbeddedFile) !Value {
		let kept = target.slot()
		return kept when kept is Value
		let d = target.descriptor
		let rt = runtime()
		// Two source folders may each have a "billing.js".
		let unit = "{d.moduleNode.qualifiedName}/{file.path}"
		let loaded = rt.engine.namespace(unit)
		let namespace = loaded is none ?? (try rt.load(unit, string(file.data)), loaded)
		let fn = try namespace.get(d.node.name)
		fail conversion("{file.path} exports no function {d.node.name}") unless fn.kind() == Kind.Function
		target.slot(fn)
		return fn
	}

	// Calls fn with the arguments of a declaration.
	internal def callWith(fn Value, args any[]) !Value {
		let rt = fn.runtime
		let lent Value[]
		let held Value[]
		let slots int[]
		for let (_, a) in args {
			let v = try argument(rt, a, lent)
			held.push(v)
			slots.push(v.slot)
		}
		let out = aqjsCall(rt.engine.handle, fn.slot, 0, slots, slots.len())
		takeBack(lent)
		return try wrap(rt, out)
	}

	// One argument of a declaration; a view over an array is added to lent.
	internal def argument(rt Runtime, a any, lent Value[]) !Value {
		return try rt.null() when a is none
		let lease ?Value = none
		match a {
			case byte[]:
				let xs byte[] = a
				lease = try rt.lend(xs)
			case int8[]:
				let xs int8[] = a
				lease = try rt.lend(xs)
			case int16[]:
				let xs int16[] = a
				lease = try rt.lend(xs)
			case uint16[]:
				let xs uint16[] = a
				lease = try rt.lend(xs)
			case int32[]:
				let xs int32[] = a
				lease = try rt.lend(xs)
			case uint32[]:
				let xs uint32[] = a
				lease = try rt.lend(xs)
			case float32[]:
				let xs float32[] = a
				lease = try rt.lend(xs)
			case float[]:
				let xs float[] = a
				lease = try rt.lend(xs)
		}
		return try rt.copy(a) when lease is none
		lent.push(lease)
		return lease
	}

	// Resolves a declaration's call with v as its declared result type,
	// named as the declaration's descriptor spells it ("!?int32").
	internal def settle(target FunctionMetaContext, v Value, declared string) !none {
		let name = declared
		name = name[1:] when name.startsWith("!")
		let optional = name.startsWith("?")
		name = name[1:] when optional
		name = name["builtin.".len():] when name.startsWith("builtin.")
		if name := "" || "none" {
			target.resolve(none)
			return none
		}
		if optional && v.isNone() {
			target.resolve(none)
			return none
		}
		match name {
			case "bool":
				target.resolve(try v.asBool())
			case "string":
				target.resolve(try v.asString())
			case "float", "float64", "float32":
				target.resolve(try v.asFloat())
			case "int", "int64":
				target.resolve(try v.asInt())
			case "int8":
				target.resolve(try within(try v.asInt(), -128, 127, name))
			case "int16":
				target.resolve(try within(try v.asInt(), -32768, 32767, name))
			case "int32":
				target.resolve(try within(try v.asInt(), -2147483648, 2147483647, name))
			case "uint8", "byte":
				target.resolve(try within(try v.asInt(), 0, 255, name))
			case "uint16":
				target.resolve(try within(try v.asInt(), 0, 65535, name))
			case "uint32":
				target.resolve(try within(try v.asInt(), 0, 4294967295, name))
			case "uint", "uint64":
				target.resolve(try within(try v.asInt(), 0, 9223372036854775807, name))
			case "byte[]", "uint8[]":
				target.resolve(try v.asBytes())
			case "bool[]":
				let out bool[]
				let n = try v.len()
				for let i = 0; i < n; i++ {
					out.push(try (try v.get(i)).asBool())
				}
				target.resolve(out)
			case "string[]":
				let out string[]
				let n = try v.len()
				for let i = 0; i < n; i++ {
					out.push(try (try v.get(i)).asString())
				}
				target.resolve(out)
			case "float[]", "float64[]":
				target.resolve(try floats<float>(v))
			case "float32[]":
				target.resolve(try floats<float32>(v))
			case "int[]", "int64[]":
				target.resolve(try integers(v))
			case "int8[]":
				target.resolve(try narrowed<int8>(v, -128, 127, name))
			case "int16[]":
				target.resolve(try narrowed<int16>(v, -32768, 32767, name))
			case "int32[]":
				target.resolve(try narrowed<int32>(v, -2147483648, 2147483647, name))
			case "uint16[]":
				target.resolve(try narrowed<uint16>(v, 0, 65535, name))
			case "uint32[]":
				target.resolve(try narrowed<uint32>(v, 0, 4294967295, name))
			case "uint[]", "uint64[]":
				target.resolve(try narrowed<uint>(v, 0, 9223372036854775807, name))
			case "any", "adm.interop.js.Value":
				target.resolve(v)
			default:
				try build(target, v, name)
		}
		return none
	}

	// Resolves a call whose declared result is a struct, an array of
	// structs or a string-keyed map, filling it from an object, an array
	// of objects or an object's own properties.
	internal def build(target FunctionMetaContext, v Value, name string) !none {
		let result = target.descriptor.signature.result
		if name.endsWith("[]") {
			let n = try v.len()
			let made any[]
			for let i = 0; i < n; i++ {
				let element = reflection.instantiate(result)
				fail conversion("a declaration cannot return {name}") when absent(element)
				try fill(element, try v.get(i))
				made.push(element)
			}
			target.resolve(made)
			return none
		}
		if name.startsWith("map<string,") {
			let made map<string, any>
			for let key in try v.keys() {
				let entry = try v.get(key)
				let element = reflection.instantiate(result)
				if absent(element) {
					made[key] = try plain(entry)
					continue
				}
				try fill(element, entry)
				made[key] = element
			}
			target.resolve(made)
			return none
		}
		let made = reflection.instantiate(result)
		fail conversion("a declaration cannot return {name}") when absent(made)
		try fill(made, v)
		target.resolve(made)
		return none
	}

	// Whether instantiate made nothing: the type is not one with fields.
	internal def absent(made any) bool {
		return reflection.typeName(made) == "none"
	}

	// A bool, number or string as its ADM value. Fails for anything else.
	internal def plain(v Value) !any {
		match v.kind() {
			case Kind.Bool:
				return try v.asBool()
			case Kind.Number:
				return try v.asFloat()
			case Kind.BigInt:
				return try v.asInt()
			case Kind.String:
				return try v.asString()
			default:
		}
		fail conversion("expected a boolean, a number or a string, got {describe(v.kind())}")
	}

	// Sets the fields of a struct from the properties of the same names;
	// a property that is missing, null or undefined leaves its field as it
	// is, and an optional field none. Fails when a property does not convert to its field's type.
	internal def fill(made any, v Value) !none {
		fail conversion("expected an object, got {describe(v.kind())}") when v.kind() := Kind.Undefined || Kind.Null || Kind.Bool || Kind.Number || Kind.BigInt || Kind.String
		for let (_, f) in reflection.fields(made) {
			let property = try v.get(f.name)
			if property.isNone() {
				f.setNone() when f.kind == FieldKind.Optional
				continue
			}
			try store(f, f.kind, property, f.name)
		}
		return none
	}

	// Stores v in a field, an array element or a map entry of this kind;
	// label names it in errors.
	internal def store(f reflection.Field, kind FieldKind, v Value, label string) !none {
		let took = true
		match kind {
			case FieldKind.Bool:
				took = f.setBool(try v.asBool())
			case FieldKind.Int, FieldKind.Enum:
				took = f.setInt(try v.asInt())
			case FieldKind.Uint:
				took = f.setUint(uint(try within(try v.asInt(), 0, 9223372036854775807, "uint")))
			case FieldKind.Float:
				took = f.setFloat(try v.asFloat())
			case FieldKind.String:
				took = f.setString(try v.asString())
			case FieldKind.Struct:
				let inner = f.ensureValue()
				fail conversion("{label} cannot be filled") when inner is none
				try fill(inner, v)
			case FieldKind.Optional:
				let elem = f.elemKind
				if elem == FieldKind.Struct {
					let inner = f.ensureValue()
					fail conversion("{label} cannot be filled") when inner is none
					try fill(inner, v)
				} else {
					try store(f, elem, v, label)
				}
			case FieldKind.Array:
				let n = try v.len()
				let elem = f.elemKind
				took = f.setLen(n)
				for let i = 0; i < n; i++ {
					try store(f.at(i), elem, try v.get(i), "{label}[{i}]")
				}
			case FieldKind.Map:
				let elem = f.elemKind
				for let key in try v.keys() {
					try store(f.entry(key), elem, try v.get(key), "{label}.{key}")
				}
			default:
				took = false
		}
		fail conversion("{label} does not take {describe(v.kind())}") unless took
		return none
	}

	// n when it lies in [low, high]; fails naming the type otherwise.
	internal def within(n int, low int, high int, typeName string) !int {
		fail conversion("{n} does not fit {typeName}") when n < low || n > high
		return n
	}

	// The elements of an array or typed array as 64-bit integers. Fails when
	// one is not an integer.
	internal def integers(v Value) !int[] {
		let n = try v.len()
		let out int[]
		out.len(n)
		let got = aqjsIntegers(v.runtime.engine.handle, v.slot, out, n)
		try raise(v.runtime) when got < 0
		out.len(got)
		return out
	}

	// The elements as integers of type T, each within [low, high].
	internal def narrowed<T: Integer>(v Value, low int, high int, typeName string) !T[] {
		let wide = try integers(v)
		let out T[]
		out.len(wide.len())
		for let (i, n) in wide {
			fail conversion("element {i}, {n}, does not fit {typeName}") when n < low || n > high
			out[i] = T(n)
		}
		return out
	}

	// The elements of an array or typed array as floats. Fails when one is
	// not a number.
	internal def floats<T: Float>(v Value) !T[] {
		let n = try v.len()
		let wide float[]
		wide.len(n)
		let got = aqjsNumbers(v.runtime.engine.handle, v.slot, wide, n)
		try raise(v.runtime) when got < 0
		let out T[]
		out.len(got)
		for let i = 0; i < got; i++ {
			out[i] = T(wide[i])
		}
		return out
	}
}
